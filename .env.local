SAP_SERVICE_LAYER_BASE_URL=https://pbss-hana-demo:30015/b1s/v1
SAP_COMPANY_DB=CONSTRUCTION
SAP_USERNAME=manager
SAP_PASSWORD=Admin@1234

# Optional target service where synced master records are posted
TARGET_SYSTEM_BASE_URL=http://localhost:5001
TARGET_SYSTEM_API_KEY=

SAP_DEFAULT_PAGE_SIZE=200

# Optional local SQL Server integration for transaction and error persistence
LOCAL_DB_ENABLED=true
LOCAL_DB_WRITE_MASTER_DATA=true
LOCAL_DB_SERVER=PBSS-WIN-DEMO
LOCAL_DB_NAME=Construction_Demo
LOCAL_DB_USER=sa
LOCAL_DB_PASSWORD=Admin@1234
LOCAL_DB_ENCRYPT=false
LOCAL_DB_TRUST_SERVER_CERTIFICATE=true

MASTER_VALIDATION_ENABLED=true
MASTER_VALIDATION_STRICT=true
MASTER_VALIDATION_MAX_ERRORS=25
